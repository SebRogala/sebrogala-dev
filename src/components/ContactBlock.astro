---
// Contact line at the bottom of an inner page, so no page ends without a next
// step. Used on /projects, /projects/pipeforge and /talks (/talks hides the
// talks link, since the reader is already there).
interface Props {
  lead?: string;
  talksLink?: boolean;
}

const { lead = 'Project, role or talk in mind?', talksLink = true } = Astro.props;
---

<aside class="contact-block">
  <p>{lead} <a href="mailto:sebrogala@gmail.com">sebrogala@gmail.com</a></p>
  <p class="contact-links">
    {talksLink && <><a href="/talks">talks &amp; workshops →</a><span class="sep">·</span></>}
    <a href="https://linkedin.com/in/sebrogala" target="_blank" rel="noopener">LinkedIn →</a>
  </p>
</aside>

<style>
  .contact-block {
    margin-top: 48px;
    font-family: var(--mono);
    font-size: 0.90625rem;
    line-height: 1.6;
    color: var(--fg-nav);
  }
  .contact-links {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .contact-block a {
    color: var(--accent);
    transition: color 160ms ease;
  }
  .contact-block a:hover {
    color: var(--fg);
  }
  .sep {
    color: var(--rule-2);
  }
</style>
