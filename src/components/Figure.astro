---
// The site's one figure: image, tap-to-zoom (the lightbox in Base.astro), and
// an optional caption. Every page and memo renders its figures through this
// component, so sizing, zoom and caption styling live in one place.
//
//   src       an import from src/assets/ (raster or SVG)
//   maxWidth  cap in CSS px; the caption follows the same width. Default: the
//             image's own width, at most 740px (the reading column).
//   sizes     rendered width per breakpoint, for raster srcset. Default derived
//             from maxWidth.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  maxWidth?: number;
  sizes?: string;
}

const { src, alt, caption, maxWidth = Math.min(src.width, 740), sizes } = Astro.props;
const isSvg = src.format === 'svg';
// Raster variants up to 2x the cap, never above the source width.
const widths = [...new Set([480, maxWidth, Math.round(maxWidth * 1.5), maxWidth * 2].map((w) => Math.min(w, src.width)))];
---

<figure class="figure" style={`max-width:${maxWidth}px`}>
  <a href={src.src} class="lightbox-link" aria-label="Open full-size image">
    {
      isSvg ? (
        <img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <Image
          src={src}
          widths={widths}
          sizes={sizes ?? `(max-width: ${maxWidth + 44}px) calc(100vw - 44px), ${maxWidth}px`}
          alt={alt}
        />
      )
    }
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 28px auto;
  }
  .figure a {
    display: block;
    border: 1px solid var(--rule-2);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-raise);
    cursor: zoom-in;
    transition: border-color 160ms ease;
  }
  .figure a:hover {
    border-color: var(--accent);
  }
  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 10px;
    font-family: var(--sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--fg-nav);
    text-wrap: pretty;
    text-align: center;
  }
  @media (max-width: 640px) {
    figcaption {
      font-size: 0.90625rem;
    }
  }
</style>
