---
// Shared top navigation. Pass `current` to highlight the active page.
interface Props {
  current?: 'home' | 'pipeforge' | 'kb' | 'about';
}
const { current = 'home' } = Astro.props;
const isActive = (page: Props['current']) => current === page;
---

<div class="nav-stack">
  <nav class="topnav">
  <div class="topnav-inner">
    <a href="/" class:list={['wordmark', { active: isActive('home') }]}>sebrogala.dev</a>
    <div class="nav-links">
      <a href="/pipeforge" class:list={['nav-link', { active: isActive('pipeforge') }]}>Pipeforge</a>
      <span class="sep">·</span>
      <a href="/kb" class:list={['nav-link', { active: isActive('kb') }]}>Knowledge base</a>
      <span class="sep">·</span>
      <a href="/about" class:list={['nav-link', { active: isActive('about') }]}>About</a>
    </div>
    <div class="nav-icons">
      <a
        href="https://github.com/SebRogala"
        aria-label="GitHub"
        class="nav-link icon-link"
        target="_blank"
        rel="noopener"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <a
        href="https://linkedin.com/in/sebrogala"
        aria-label="LinkedIn"
        class="nav-link icon-link"
        target="_blank"
        rel="noopener"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"
          ><path
            d="M13.6 0H2.4A2.4 2.4 0 0 0 0 2.4v11.2A2.4 2.4 0 0 0 2.4 16h11.2a2.4 2.4 0 0 0 2.4-2.4V2.4A2.4 2.4 0 0 0 13.6 0zM4.84 13.6H2.56V6.08h2.28v7.52zM3.7 5.06a1.32 1.32 0 1 1 0-2.64 1.32 1.32 0 0 1 0 2.64zm9.9 8.54h-2.28V9.94c0-.85-.02-1.94-1.18-1.94-1.18 0-1.36.92-1.36 1.88v3.72H6.5V6.08h2.18v1.03h.03c.3-.57 1.04-1.18 2.14-1.18 2.3 0 2.72 1.51 2.72 3.48v4.19z"
          ></path></svg
        >
      </a>
    </div>
  </div>
</nav>

<!-- Mobile sub-nav: hidden by default, shown on narrow viewports. -->
  <nav class="mobile-subnav">
    <a href="/pipeforge" class:list={['nav-link', { active: isActive('pipeforge') }]}>Pipeforge</a>
    <a href="/kb" class:list={['nav-link', { active: isActive('kb') }]}>KB</a>
    <a href="/about" class:list={['nav-link', { active: isActive('about') }]}>About</a>
  </nav>
</div>

<style>
  /* Both nav rows scroll together as one sticky unit so there's never
     a gap of page background visible between them. */
  .nav-stack {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg-base);
    backdrop-filter: saturate(140%) blur(6px);
    -webkit-backdrop-filter: saturate(140%) blur(6px);
  }
  .topnav {
    border-bottom: 1px solid var(--rule);
    padding: 20px 0;
  }
  .topnav-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg-nav);
    letter-spacing: 0.01em;
    transition: color 160ms ease;
  }
  .wordmark:hover,
  .wordmark.active {
    color: var(--fg);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
  }
  .nav-link {
    color: var(--fg-nav);
    transition: color 160ms ease;
  }
  .nav-link.active {
    color: var(--fg);
  }
  .nav-link:hover {
    color: var(--accent);
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
  }
  .nav-icons {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sep {
    color: var(--rule-2);
  }

  .mobile-subnav {
    display: none;
    padding: 12px 22px;
    border-bottom: 1px solid var(--rule);
    gap: 18px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .topnav-inner {
      padding: 0 22px;
    }
    .nav-links {
      display: none;
    }
    .mobile-subnav {
      display: flex;
    }
  }
</style>
