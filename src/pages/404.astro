---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
---

<Base
  title="404 · page not found"
  description="The page you were looking for doesn't exist."
  noindex
>
  <TopNav />

  <main class="frame">
    <section class="hero">
      <div class="eyebrow">Error 404</div>
      <h1>Page not found</h1>
      <p class="lede">
        The page you were looking for doesn't exist, or has moved. No drama, just a missing path.
      </p>
    </section>

    <section class="links">
      <div class="eyebrow">Try one of these</div>
      <ul>
        <li><a href="/">Home</a>: landing page, work tiles, availability</li>
        <li><a href="/projects">Projects</a>: products and side projects</li>
        <li><a href="/projects/pipeforge">Pipeforge</a>: orchestration walkthrough</li>
      </ul>
    </section>
  </main>
</Base>

<style>
  .frame {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .hero {
    padding: 80px 0 32px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.78125rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 3.3125rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 18px;
  }
  .lede {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.3125rem;
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
    max-width: 660px;
  }

  .links {
    padding: 36px 0 80px;
    border-top: 1px solid var(--rule);
  }
  .links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--sans);
    font-size: 1.03125rem;
    line-height: 1.75;
    color: var(--fg);
  }
  .links li + li {
    margin-top: 4px;
  }
  .links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }

  @media (max-width: 640px) {
    .frame {
      padding: 0 22px;
    }
    .hero {
      padding: 48px 0 24px;
    }
    .hero h1 {
      font-size: 2.1875rem;
    }
    .lede {
      font-size: 1.09375rem;
    }
    .links {
      padding: 24px 0 48px;
    }
  }
</style>
