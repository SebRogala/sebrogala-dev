---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';

const screenshotsAsOf = '2026-04-27';

// Each panel: image filename in /screenshots, caption (headline), body (what-it-shows).
// Order + copy follows docs/MANIFEST_V2.md narrative.
const panels = [
  {
    section: 'Discovery & planning',
    img: '03-execution-order-dependency-graph.png',
    alt: 'Chunk dependency graph: backend foundation → tests + 3 independent frontends',
    caption: 'Chunk dependency graph: backend foundation → tests + 3 independent frontends',
    body: 'Planner output for an epic. Chunk 1 (backend) is the foundation; Chunk 2 (backend-test) waits for it; Chunks 3 / 4 / 6 (frontend, comparator backend, desktop/OCR) can run in parallel after Chunk 1; Chunk 5 (comparator frontend) waits for Chunk 4. The numbered list translates the diagram into execution rules the orchestrator follows.',
  },
  {
    section: 'Workspace coordination',
    img: '13-show-routes-multi-worktree-state.png',
    alt: '/show-routes: three concurrent worktrees, current task per route, progress bars',
    caption: '`/show-routes`: three concurrent worktrees, current task per route, progress bars',
    body: 'Lightweight workspace-state visualiser. Three worktrees (main / second / third), each with its active route, current in-progress task, and progress bar (2/6, 0/1, 5/5 done). Plus per-route next-step suggestions. Visual proof of the "parallel worktrees" workflow claim.',
  },
  {
    section: 'Workspace coordination',
    img: '05-whats-next-route-overview.png',
    alt: '/whats-next: three available routes with conflict-risk and readiness pills',
    caption: '`/whats-next`: three available routes with conflict-risk and readiness pills',
    body: 'Route-discovery output across one workspace. A fresh epic (Desktop App v2, 0/4 with LOW conflict risk and 4 ordered subtasks), a 3-task actionable bundle (Standalone v1.0), and an in-flight resume option (11 fixed, ~16 remain). Status pills (●/●/●) signal readiness; conflict-risk surfaces upfront so the operator picks safely.',
  },
  {
    section: 'Plan review gate',
    img: '10-plan-reviewer-mcp-context-load.png',
    alt: 'Plan-reviewer self-loads context: getConfig, getDiscoveries, YouTrack issue',
    caption: 'Plan-reviewer self-loads context: `getConfig`, `getDiscoveries`, YouTrack issue',
    body: 'After single-task mode is confirmed, the plan-reviewer agent dispatches and immediately pulls context from MCP — Pipeforge\'s `getConfig` and `getDiscoveries`, plus the external tracker integration (YouTrack issue lookup). Layered context loading in action: orchestrator passes only a task ID; the sub-agent self-loads everything it needs.',
  },
  {
    section: 'Plan review gate',
    img: '11-plan-reviewer-findings-classification.png',
    alt: 'Plan review finishes with 5 severity-classified findings + a graceful proceed prompt',
    caption: 'Plan review: 5 severity-classified findings + a graceful proceed prompt',
    body: 'Review completed in 1m 10s (10 tool uses, 33.1k tokens). Each finding carries a one-line summary AND a concrete fix recommendation. The orchestrator then offers 4 paths: address all / highs only / proceed anyway / skip task. Implementation gate that catches design issues *before* code is written.',
  },
  {
    section: 'Pipeline execution',
    img: '04-foundation-then-parallel-group2.png',
    alt: 'Foundation chunk done in 14m 9s, 5 agents dispatching for the next wave',
    caption: 'Foundation chunk done in 14m 9s, 5 agents dispatching for the next wave',
    body: 'Same project as the dependency graph above, now running. Group 1 backend (POE-65 backend engine) completed — 86 tool uses, 104.5k tokens. The orchestrator then dispatches Group 2 (chunks 2 / 3 / 4 / 6, all depending on chunk 1) plus a light review for chunk 1 — 5 concurrent agents, each tagged with its specialisation (general, backend-test, frontend, backend, general). Colour-coded labels make agent type visually obvious.',
  },
  {
    section: 'Pipeline execution',
    img: '02-parallel-chunks-group1-complete.png',
    alt: '8 agents in parallel: Group 1 light reviews + Group 2 implementers',
    caption: '8 agents in parallel: Group 1 light reviews + Group 2 implementers',
    body: 'Mid-pipeline orchestration. Group 1 (4 implementer chunks: data layer, color API, CSS styles, preferences) reports per-agent token + tool-use accounting. The orchestrator immediately dispatches Group 2 implementers (4 agents) alongside light reviewers for Group 1 (4 more) — dependency-aware planning combined with parallel scheduling.',
  },
  {
    section: 'Heavy-review boundary',
    img: '14-heavy-review-complete-findings-table.png',
    alt: '5 reviewers, 34 findings, 0 critical — clean to merge',
    caption: '5 reviewers, 34 findings, 0 critical — clean to merge',
    body: 'Heavy-review output. Five specialised agents finished in parallel (code-reviewer, pr-test-analyzer, silent-failure-hunter, comment-analyzer, type-design-analyzer) with token / tool-use transparency per agent. Findings classified Critical / Important / Suggestion / Deferred per agent, with a module breakdown (`backend 21+1 deferred · backend-test 13+1 deferred`). 0 Critical = merge gate clears. The pattern is derived from the open-source `pr-review-toolkit`, adapted to the Pipeforge agent model.',
  },
  {
    section: 'Fidelity audit',
    img: '12-fidelity-auditor-handler-moves-clean.png',
    alt: 'Handler refactor verified: 17/17 atoms preserved, 2 cosmetic LOWs explained',
    caption: 'Handler refactor verified: 17/17 atoms preserved, 2 cosmetic LOWs explained',
    body: 'The auditor\'s voice on a real refactor. 17 behavioural atoms preserved across both handler moves, 0 missing. Two LOW-severity deltas surfaced with rationale: a string prefix shortening that\'s *more* correct given the new caller path, and a log message rename that\'s purely cosmetic. Calibrated, doesn\'t cry wolf.',
  },
  {
    section: 'Fidelity audit',
    img: '15-fidelity-auditor-critical-drift-caught.png',
    alt: 'A real regression caught: flash key silently unified across two flows',
    caption: 'A real regression caught: flash key silently unified across two flows',
    body: 'The "why this matters" example. During a refactor, an `\\InvalidArgumentException` flash key changed in a way that silently merged two distinct user-facing flows into one generic error message. The auditor surfaces: original key, new key, file:line range, the exact UX consequence, and a one-line revert fix. Verdict: 20/21 OK, 1 CRITICAL DRIFT.',
  },
  {
    section: 'Test audit',
    img: '07-test-audit-all-suites-clean.png',
    alt: '4,190 PHP tests + 157 E2E green, 259 structured learnings logged in 7m 13s',
    caption: `4,190 PHP tests + 157 E2E green, 259 structured learnings logged in 7m 13s (as of ${screenshotsAsOf})`,
    body: 'Full test-audit output. PHPStan clean, Unit 2674/2674 (8539 assertions), Integration 459/459, Functional 699/699, Smoke 201/201, E2E 157/157 (1 intentional skip). Plus 259 learnings extracted across backend / e2e / frontend / pattern / gotcha — top categories called out for the next `/integrate-agent-learnings` pass.',
  },
];

const appendix = [
  { img: '01-fidelity-audit-pass-summary.png', caption: 'Fidelity audit PASS — 4-row severity table on a structural docs merge. ~45 atoms preserved, full run 4m 31s.' },
  { img: '06-whats-next-backlog-breakdown.png', caption: '`/whats-next` continued: 13-task backlog flagged for `/discover-routes`, 6 epics flagged "needs `/breakdown` first".' },
  { img: '08-deliver-flow-shipping-options.png', caption: '`/deliver` prompts the operator with 5 shipping modes: adaptive single-flow, two-step, hand-implement, park, free text.' },
  { img: '09-deliver-route-safety-check.png', caption: 'Step 0 catches a route mismatch and pauses for user resolution — 4 explicit options instead of failing or proceeding blindly.' },
];
---

<Base
  title="Pipeforge — sebrogala.dev"
  description="Pipeforge: Claude Code orchestration plugin and PostgreSQL MCP backend. Personal AI delivery infrastructure with verification, fidelity audits, and source-cited knowledge."
>
  <TopNav current="pipeforge" />

  <main class="frame">
    <header class="page-header">
      <div class="eyebrow">Walkthrough</div>
      <h1>Pipeforge</h1>
      <p class="lede">
        Personal Claude Code orchestration plugin and PostgreSQL MCP backend. Built from a personal need to
        coordinate work across multiple machines and parallel worktrees, then evolved into where I prototype
        the context-engineering patterns I apply in client work.
      </p>
      <p class="sub-lede">
        This is not a product. It is the infrastructure I use daily. Below: real screenshots from real runs,
        in execution order. Tracker IDs from a public open-source project (`POE-###`) are kept visible —
        they are already public on GitHub. Tracker IDs from a proprietary client project have been replaced
        with `[TSK-000]` placeholders.
      </p>
    </header>

    <section class="stats">
      <div class="stat">
        <div class="stat-num">31</div>
        <div class="stat-label">commands</div>
      </div>
      <div class="stat">
        <div class="stat-num">28</div>
        <div class="stat-label">SKILL.md files</div>
      </div>
      <div class="stat">
        <div class="stat-num">20</div>
        <div class="stat-label">agents</div>
      </div>
      <div class="stat">
        <div class="stat-num">11</div>
        <div class="stat-label">pipeline templates</div>
      </div>
      <div class="stat">
        <div class="stat-num">64</div>
        <div class="stat-label">MCP tools</div>
      </div>
      <div class="stat">
        <div class="stat-num">31</div>
        <div class="stat-label">Postgres tables</div>
      </div>
    </section>

    <section class="prose">
      <h2>What it does, briefly</h2>
      <p>
        Two orchestration patterns from different context-window eras: <strong>`/pipe`</strong> —
        orchestrator clears, MCP holds state, sub-agents do the work (built to survive the compact-prone
        200k era). <strong>`/deliver`</strong> — orchestrator keeps full context, dispatches from there
        (viable once 1M removed compact pressure). A configurable <code>context_window_size</code> drives
        chunk sizing independently of pattern.
      </p>
      <p>
        Layered defence: structured state over fuzzy retrieval, source citations on KB entries, sub-agent
        adversarial review, verification before completion, heavy-review (up to 5 parallel reviewer agents,
        derived from the open-source <code>pr-review-toolkit</code>), and hook-level enforcement
        (e.g. <code>cd</code> blocking to prevent worktree drift).
      </p>
    </section>

    {
      panels.map((p, i) => (
        <section class="panel">
          <div class="panel-meta">
            <div class="panel-num">{String(i + 1).padStart(2, '0')}</div>
            <div class="panel-section-label">{p.section}</div>
          </div>
          <figure class="panel-figure">
            <a
              href={`/screenshots/${p.img}`}
              class="lightbox-link"
              aria-label="Open full-size screenshot"
            >
              <img
                src={`/screenshots/${p.img}`}
                alt={p.alt}
                loading="lazy"
                decoding="async"
              />
            </a>
            <figcaption>{p.caption}</figcaption>
          </figure>
          <p class="panel-body">{p.body}</p>
        </section>
      ))
    }

    <section class="prose">
      <h2>Two stories the screenshots back up</h2>

      <h3>1 — Caught an Opus 4.7 regression with my own pipeline telemetry</h3>
      <p>
        After upgrading to Opus 4.7, identical pipeline shapes — same task graphs, same skills,
        only the model changed — ran <strong>~2× wall-clock and ~2.3× tokens</strong> vs the Opus
        4.6 baseline. Eight+ runs on real tasks ruled out variance.
      </p>
      <p>Two reproducible root causes:</p>
      <ul>
        <li>
          <strong>Disk round-tripping of in-memory MCP results.</strong> Sub-agents materialised
          MCP tool responses to the tool-results spool and looped <code>Read</code> + <code>jq</code>
          over them instead of using the in-context value. Same file re-read 10+ times inside a
          single agent run, multiplied across every implement / heavy-review fan-out.
        </li>
        <li>
          <strong>Literal-instruction adherence overriding session-level config.</strong>
          Per-session overrides ("don't post deferred items to the tracker") were acknowledged
          and then violated — the agent reverted to the written spec, silently, with
          plausible-looking output.
        </li>
      </ul>
      <p>
        Shipped two revertible spec fixes — config-honoured deferred mode and DRY-extracted
        per-phase metrics capture — and filed the reproducible investigation upstream:
        <a
          href="https://github.com/anthropics/claude-code/issues/6354#issuecomment-3849990217"
          target="_blank"
          rel="noopener"
          >anthropics/claude-code#6354</a
        >.
      </p>

      <h3>2 — The fidelity-auditor exists because of a near-miss</h3>
      <p>
        During a docs migration, AI silently summarised <strong>491 lines of behavioural specs
        into 122</strong>. Type-checks passed. Tests passed. The behaviour was structurally fine
        but operationally lossy — the kind of regression that doesn't surface until months later,
        in production, as <em>"wait, I thought we did X here?"</em>
      </p>
      <p>
        The fidelity-auditor is the structural fix. On every move / split / extract, it classifies
        behavioural atoms as <strong>Missing / Simplified / Evolved / Preserved</strong>, prints
        severity per row, and demands explicit reasoning on every LOW. It refuses to ship a
        verdict it can't justify — see the two fidelity-audit panels above (a clean handler
        refactor with calibrated LOWs, and a real regression caught) for what that looks like in
        practice.
      </p>
    </section>

    <section class="appendix">
      <h2>Appendix — more artefacts</h2>
      <p class="appendix-intro">
        Four additional screenshots covering more of the same pipeline surface. Same redaction
        policy as above.
      </p>
      <div class="appendix-grid">
        {
          appendix.map((a) => (
            <figure class="appendix-figure">
              <a
                href={`/screenshots/${a.img}`}
                class="lightbox-link"
                aria-label="Open full-size screenshot"
              >
                <img src={`/screenshots/${a.img}`} alt={a.caption} loading="lazy" decoding="async" />
              </a>
              <figcaption>{a.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <footer class="page-footer">
      <a href="/">← back</a>
      <span class="sep">·</span>
      <a href="/kb">Knowledge base →</a>
    </footer>
  </main>
</Base>

<style>
  .frame {
    max-width: 1140px;
    margin: 0 auto;
    padding: 48px 32px;
  }
  /* Content blocks span the full frame width (matching Home). If specific
     long-form paragraphs need narrower line lengths for readability, cap
     them individually — not at the section level. */

  /* Topnav lives in src/components/TopNav.astro. */
  /* `.sep` is also used in the page footer below — keep as page-level rule. */
  .sep {
    color: var(--rule-2);
  }

  .page-header {
    margin-bottom: 36px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 44px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 18px;
  }
  .lede {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
    margin-bottom: 16px;
  }
  .sub-lede {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-nav);
    text-wrap: pretty;
  }
  .sub-lede code {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--fg-nav);
    background: var(--bg-raise);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 36px;
  }
  .stat {
    text-align: center;
  }
  .stat-num {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 28px;
    color: var(--accent);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .stat-label {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 4px;
    line-height: 1.3;
  }

  .prose {
    margin: 32px 0 36px;
    font-family: var(--sans);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--fg);
  }
  .prose h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    color: var(--fg);
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }
  .prose h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 17px;
    color: var(--accent);
    margin: 28px 0 10px;
    letter-spacing: -0.005em;
  }
  .prose p + p,
  .prose p + ul,
  .prose ul + p {
    margin-top: 14px;
  }
  .prose ul {
    padding-left: 22px;
    margin: 0;
  }
  .prose li {
    margin-bottom: 8px;
  }
  .prose li:last-child {
    margin-bottom: 0;
  }
  .prose em {
    color: var(--muted);
    font-style: italic;
  }
  .prose code {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg-nav);
    background: var(--bg-raise);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .prose strong {
    color: var(--fg);
    font-weight: 600;
  }
  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.4);
  }

  .panel {
    border-top: 1px solid var(--rule);
    padding: 36px 0;
  }
  .panel-meta {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: 12px;
  }
  .panel-num {
    color: var(--accent);
    font-weight: 500;
  }
  .panel-section-label {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
  }
  .panel-figure {
    margin: 0 0 18px;
  }
  .panel-figure a {
    display: block;
    border: 1px solid var(--rule-2);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-raise);
    transition: border-color 160ms ease;
  }
  .panel-figure a:hover {
    border-color: var(--accent);
  }
  .panel-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .panel-figure figcaption {
    margin-top: 10px;
    font-family: var(--sans);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--fg-nav);
    text-wrap: pretty;
  }
  .panel-body {
    font-family: var(--sans);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--fg);
    text-wrap: pretty;
  }

  .appendix {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid var(--rule);
  }
  .appendix h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    color: var(--fg);
    margin-bottom: 12px;
  }
  .appendix-intro {
    font-family: var(--sans);
    font-size: 14.5px;
    color: var(--fg-nav);
    margin-bottom: 24px;
  }
  .appendix-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .appendix-figure {
    margin: 0;
  }
  .appendix-figure a {
    display: block;
    border: 1px solid var(--rule-2);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-raise);
    transition: border-color 160ms ease;
  }
  .appendix-figure a:hover {
    border-color: var(--accent);
  }
  .appendix-figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .appendix-figure figcaption {
    margin-top: 8px;
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--fg-nav);
  }

  .page-footer {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 13px;
    display: flex;
    gap: 12px;
  }
  .page-footer a {
    color: var(--accent);
    transition: color 160ms ease;
  }
  .page-footer a:hover {
    color: var(--fg);
  }

  @media (max-width: 720px) {
    .frame {
      padding: 36px 22px;
    }

    h1 {
      font-size: 32px;
    }
    .lede {
      font-size: 16px;
    }
    .sub-lede {
      font-size: 13px;
    }

    .stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .stat-num {
      font-size: 22px;
    }

    .panel {
      padding: 28px 0;
    }
    .panel-figure figcaption {
      font-size: 13px;
    }
    .panel-body {
      font-size: 15px;
    }

    .appendix-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
</Base>
