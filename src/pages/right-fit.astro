---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Reached from Home → Availability ("Full-time for the right fit →") or by
// URL; deliberately not in the nav. The three work items carry equal weight:
// same styling whatever the description length, no numbering, no "primary".
const work = [
  {
    lead: 'Building the product',
    description:
      'From discovery onwards: understanding the problem and the outcome before deciding how to build it, ideally before the scope is locked, then new systems or extensions of existing ones, through to production.',
    proof: { label: null, links: [{ text: 'Education SaaS', href: '/projects#education-saas' }] },
  },
  {
    lead: 'Applied AI R&D',
    description:
      "On the workflows a team uses every day: researching where they can get better, prototyping, and saying honestly whether AI fits, in the process or in the product. Often that means several AIs working through one main agent that knows my standards: it writes each tool's input and checks what comes back. Product AI is newer ground for me, and I want to learn it.",
    proof: {
      label: 'Claude Design playbook:',
      links: [
        { text: 'repo', href: 'https://github.com/SebRogala/claude-design-playbook' },
        { text: 'memo', href: '/memos/claude-design-playbook' },
      ],
    },
  },
  {
    lead: 'DevEx / AI-native SDLC',
    description:
      'Building how a team delivers with AI agents in the real workflow: the gates, conventions and tooling that make AI-written code safe to ship, so the whole team gets the same results, not just one person.',
    proof: {
      label: 'Pipeforge:',
      links: [
        { text: 'project', href: '/projects/pipeforge' },
        { text: 'memo', href: '/memos/handoff-instead-of-compact' },
      ],
    },
  },
];

const team = [
  'I have a real say in the technical approach.',
  'Testing and production quality belong to the people who build.',
  "Knowledge flows both ways: I share what I've learned and learn from the others.",
  "There's room to improve how the team works, not only what it ships.",
  'Product questions reach someone who can answer them.',
];
---

<Base
  title="Right fit · Sebastian Rogala"
  description="I'm open to fractional and contract work, and to a full-time role when it comes close to the work below."
>
  <TopNav current="right-fit" />

  <main class="frame">
    <header class="page-header">
      <div class="eyebrow">Availability</div>
      <h1>Right fit</h1>
      <p class="lede">I'm open to fractional and contract work, and to a full-time role when it comes close to the work below. This is my dream work. A role rarely matches all of it, and one that matches part is still worth a message.</p>
    </header>

    <section class="content">
      <div class="group">
        <h2>The work</h2>
        <ul class="list work-list">
          {
            work.map((item) => (
              <li>
                <span class="lead">{item.lead}</span>
                <span class="description">{item.description}</span>
                <span class="proof">
                  <span class="muted" aria-hidden="true">↳</span>
                  {item.proof.label}
                  {item.proof.links.map((link, i) => (
                    <>
                      {i > 0 && <span class="muted">·</span>}
                      <a href={link.href}>{link.text}</a>
                    </>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="group">
        <h2>The team</h2>
        <ul class="list team-list">
          {team.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="location">
        <span class="location-label">Location</span>
        <p>An office in or near Rzeszów, or fully remote.</p>
      </div>
    </section>

    <SiteFooter>
      <a href="/">← back home</a>
    </SiteFooter>
  </main>
</Base>

<style>
  .frame {
    max-width: 1140px;
    margin: 0 auto;
    padding: 48px 32px;
  }

  /* Header: the /talks page-header pattern. Text runs the full frame; only
     memo pages keep the narrow 740 measure. */
  .page-header {
    margin-bottom: 36px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.78125rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 3.03125rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 16px;
  }
  .lede {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.3125rem;
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
  }

  .group + .group {
    margin-top: 52px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.9375rem;
    letter-spacing: -0.015em;
    color: var(--fg);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    margin: 0 0 4px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--fg);
    text-wrap: pretty;
    border-bottom: 1px solid var(--rule);
  }
  .list li:last-child {
    border-bottom: 0;
  }
  .team-list li {
    padding: 16px 0;
    opacity: 0.86;
  }
  .work-list li {
    padding: 20px 0;
  }

  .lead {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.375rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .description {
    display: block;
    opacity: 0.86;
  }
  .proof {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 8px;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 0.84375rem;
    line-height: 1.5;
    color: var(--fg-nav);
  }
  .proof a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
    transition: color 160ms ease;
  }
  .proof a:hover {
    color: var(--fg);
  }
  .muted {
    color: var(--muted);
  }

  .location {
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
  }
  .location-label {
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--accent);
  }
  .location p {
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .frame {
      padding: 36px 22px;
    }
    h1 {
      font-size: 2.1875rem;
    }
    .lede {
      font-size: 1.09375rem;
    }
    h2 {
      font-size: 1.59375rem;
    }
    .list li {
      font-size: 1rem;
    }
    .lead {
      font-size: 1.25rem;
    }
    .proof {
      font-size: 0.8125rem;
      margin-top: 6px;
    }
    .location {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .location p {
      font-size: 1rem;
    }
  }
</style>
