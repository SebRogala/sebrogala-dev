---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import PastTalks from '../components/PastTalks.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { omsLive, omsPhase, omsScopeVerb, capitalize } from '../lib/oms';
import { personJsonLd } from '../lib/structuredData';
import { getMemos, formatDate, renderTitle, wordCount } from '../lib/memos';
import { readingMinutesTotal } from '../lib/reading';

// Newest three; fewer when fewer are published, none renders no section.
const latestMemos = (await getMemos()).slice(0, 3);

// ─── Tile data ───────────────────────────────────────────────────
// Ranked the way a buyer reads them: shipped and in-progress custom software
// first, the machinery that ships it second, the public artefact third.
const tiles = [
  {
    n: '01',
    title: 'Education SaaS',
    tagline: 'built for its first client',
    body: 'Multi-tenant education CRM. Hexagonal modular monolith on Symfony, gated on every merge.',
    stack: 'PHP/Symfony · PostgreSQL · Redis · Twig',
    href: '/projects#education-saas',
    linkLabel: 'details',
    live: null,
    durable: 'in production since 03.2026',
  },
  {
    n: '02',
    title: 'OMS / backoffice',
    tagline: 'client project',
    body: `Order management for a building-materials e-shop. ${capitalize(omsScopeVerb)} the most-used ~80% of a legacy admin.`,
    stack: 'Symfony · Symfony UX · Tailwind · PostgreSQL',
    href: '/projects#oms-backoffice',
    linkLabel: 'details',
    live: null,
    durable: omsPhase,
  },
  {
    n: '03',
    title: 'Pipeforge + Fleetforge',
    tagline: 'delivery tooling',
    body: 'Orchestration for Claude Code and Codex on a PostgreSQL MCP server, run by written rules the agents must follow for planning, tests and review. Every project here ships through it.',
    stack: 'Claude Code · Codex · MCP · PostgreSQL',
    href: '/projects/pipeforge',
    linkLabel: 'walkthrough',
    live: null,
    durable: 'private · used daily',
  },
  {
    n: '04',
    title: 'ProfitOfExile',
    tagline: 'side project',
    body: 'Windows companion app for Path of Exile that helps players decide using live market prices.',
    stack: 'Go · Rust/Tauri · SvelteKit · TimescaleDB · OCR',
    href: '/projects#profitofexile',
    linkLabel: 'details',
    live: null,
    durable: 'GPL-3.0 · community-adopted',
  },
];
---

<Base
  title="Sebastian Rogala, AI-Native Software Engineer | Agentic SDLC"
  description="AI-native software engineer who builds by directing AI agents and verifying the outcome. Talks, workshops and consulting on AI-native delivery."
  jsonLd={personJsonLd}
>
  <TopNav current="home" />

  <main class="frame">
    <!-- ── Hero: text left, illustration right on desktop ────── -->
    <div class="hero-row">
    <section class="hero">
      <h1>Sebastian Rogala</h1>
      <p class="tagline">AI-Native Software Engineer | Agentic SDLC</p>
      <p class="subline">AI agents build the software. I direct them and verify it works.</p>
    </section>

    <!-- ── Fan-out illustration (no caption; alt carries it) ─── -->
    <div class="hero-art">
      <img
        src="/site-hero-fleet-v3.webp"
        width="1536"
        height="1024"
        alt="Illustration: Sebastian facing a coordinator agent that fans out to supervisors, orchestrators and many working agents."
      />
    </div>
    </div>

    <!-- ── Pitch + pull-quote ────────────────────────────────── -->
    <section class="section pitch-section">
      <div class="main-col">
        <h2 class="eyebrow">What I do</h2>
        <p class="pitch">I'm a software engineer with over a decade of broad experience, fully AI-directed since early 2026. I build software by directing AI agents and verifying the outcome. I also give talks, and offer workshops and consulting on AI-native delivery. Beyond code I explore other uses of AI too, like local Whisper turning client meetings into tasks and Demucs separating audio stems.</p>
      </div>
      <div class="side-col">
        <div class="pull-quote">
          “AI failures are spec gaps, not agent shortcomings.”
          <div class="pull-quote-attr">how I read most agent failures</div>
        </div>
      </div>
    </section>

    <!-- ── Tiles header ─────────────────────────────────────── -->
    <section class="section tiles-header">
      <h2 class="eyebrow">Current work</h2>
    </section>

    <!-- ── Work tiles ────────────────────────────────────────── -->
    <section class="tiles">
      {
        tiles.map((t) => (
          <a href={t.href} class="tile-row tile-link">
            <div class="tile-num">{t.n}</div>
            <div class="tile-content">
              <div class="tile-heading">
                {t.title}
                <span class="tile-tagline"> · {t.tagline}</span>
              </div>
              <div class="tile-body">{t.body}</div>
              <div class="tile-stack">{t.stack}</div>
            </div>
            <div class="tile-side">
              <div class="tile-arrow">{t.linkLabel} →</div>
              {t.live && (
                <div class="sidenote-live">
                  <span class="live-dot" />
                  {t.live}
                </div>
              )}
              <div class="sidenote-durable">{t.durable}</div>
            </div>
          </a>
        ))
      }
    </section>

    <!-- ── Latest memos: each row IS the link (no nested links). ── -->
    {latestMemos.length > 0 && (
      <section class="section memos-section">
        <div class="main-col">
          <h2 class="eyebrow">Latest memos</h2>
          <ul class="lm-list">
            {latestMemos.map((memo) => {
              const minutes = `~${readingMinutesTotal(wordCount(memo))} min`;
              return (
                <li>
                  <a href={`/memos/${memo.id}`} class:list={['lm-row', { 'no-cover': !memo.data.cover }]}>
                    {memo.data.cover && (
                      <figure class="lm-mini">
                        <img
                          src={memo.data.cover.src}
                          width={memo.data.cover.width}
                          height={memo.data.cover.height}
                          alt=""
                          loading="lazy"
                        />
                      </figure>
                    )}
                    <span class="lm-title" set:html={renderTitle(memo.data.title)} />
                    <span class="lm-date">
                      {formatDate(memo.data.published)}<span class="lm-date-min"> · {minutes}</span>
                    </span>
                    <span class="lm-min">{minutes}</span>
                  </a>
                </li>
              );
            })}
          </ul>
          <p class="speaking-more"><a href="/memos">all memos →</a></p>
        </div>
      </section>
    )}

    <!-- ── Speaking ──────────────────────────────────────────── -->
    <section class="section speaking-section">
      <div class="main-col">
        <h2 class="eyebrow">Speaking</h2>
        <PastTalks />
        <p class="speaking-more"><a href="/talks">talks &amp; workshops →</a></p>
      </div>
    </section>

    <!-- ── Availability (no fixed quarter — just an "open" signal). ─ -->
    <section class="section availability" id="availability">
      <div class="avail-head">
        <h2 class="eyebrow">Availability</h2>
        <div class="status-pill">
          <span class="status-dot"></span>
          open
        </div>
      </div>
      <div class="avail-strip">
        <p class="avail-fit">Full-time for the <a href="/right-fit">right fit →</a></p>
        <p class="avail-where">An office in or near Rzeszów, or fully remote.</p>
      </div>
      <ul class="shapes">
        <li>
          <span class="shape-name">Custom software projects</span>
          From defining the need to launch and handover, like the <a href="/projects#education-saas">Education SaaS</a>{omsLive && <> and the <a href="/projects#oms-backoffice">OMS</a></>}.
        </li>
        <li>
          <span class="shape-name">Fractional delivery</span>
          I run delivery on your codebase.
        </li>
        <li>
          <span class="shape-name">Advisory</span>
          Where your review bottleneck sits, and what to enforce structurally.
        </li>
        <li>
          <span class="shape-name">Workshops and training</span>
          How a team moves from prompting to directing agents. <a href="/talks">topics →</a>
        </li>
      </ul>
      <p class="cta">
        <a class="cta-link" href="mailto:sebrogala@gmail.com?subject=Custom%20software%20%2F%20delivery%20work">
          Tell me what you're shipping →
        </a>
      </p>
    </section>

    <SiteFooter />
  </main>
</Base>

<style>
  /* ─── Layout constants ────────────────────────────────────── */
  /* Frame 1140 max · Body 660 + 28 gutter + 1fr right column.
     Pull-quote constrained by .pull-quote max-width; tile sidenotes right-align. */

  .frame {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Topnav + mobile-subnav styles live in src/components/TopNav.astro. */

  /* ─── Hero ─────────────────────────────────────────────── */
  .hero {
    padding: 60px 0 24px;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 3.84375rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 14px;
  }
  .tagline {
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  /* The sub-line carries the category (Rule 8: it has to land from the grammar
     of the first sentence, not from the label above it), so it is set at
     reading weight rather than as a caption. */
  .subline {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.375rem;
    line-height: 1.5;
    color: var(--fg);
    text-wrap: pretty;
  }

  /* ─── Hero illustration ────────────────────────────────── */
  /* Capped at the 740px main track and at 60vh so the whole fan-out stays
     visible, scaled, never cropped. The WebP carries its own alpha: the painted
     background is keyed out (soft, luminance-based, with the figure kept
     opaque and the frame edges faded), so the page gradient shows through
     and no box or CSS edge mask is needed. */
  .hero-art {
    padding: 0 0 32px;
  }
  .hero-art img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 740px);
    max-height: 60vh;
    object-fit: contain;
  }

  /* From 900px the hero text (45%) and the illustration (55%) sit side by
     side, so the image fills the right of the frame instead of a row of its
     own and "What I do" lands above the fold at 1440x900. Below 900px they
     stack as before. The h1 is 3.5rem here (3.84rem stacked) because the
     name did not fit the 45% column on one line. */
  @media (min-width: 900px) {
    .hero-row {
      display: grid;
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      column-gap: 32px;
      align-items: center;
      padding: 48px 0 32px;
    }
    .hero-row .hero,
    .hero-row .hero-art {
      padding: 0;
    }
    .hero-row .hero h1 {
      font-size: 3.5rem;
    }
    .hero-row .hero-art img {
      max-width: 100%;
    }
  }

  /* ─── Pitch section ────────────────────────────────────── */
  .section {
    padding: 40px 0 52px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 740px) 28px 1fr;
  }
  .pitch-section .main-col {
    grid-column: 1;
  }
  .pitch-section .side-col {
    grid-column: 3;
    padding-top: 30px;
  }

  /* On this page `.eyebrow` is an <h2>: the section headings were previously
     non-semantic divs, so the page had one <h1> and no <h2> at all. On the other
     pages `.eyebrow` is a kicker <div> above the <h1> and stays caption-sized. */
  .eyebrow {
    font-family: var(--mono);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .pitch {
    font-family: var(--serif);
    /* Pitch weight bumped from 400 → 500 to anchor the page (one of three metric-reduction tweaks) */
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
  }

  .pull-quote {
    /* width capped + pushed to the right of column 3 so the pull-quote sits
       at the same right-edge as the tile sidenotes below — visual consistency
       across the page. */
    max-width: 240px;
    margin-left: auto;
    border-left: 2px solid var(--accent);
    padding-left: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--fg);
    text-wrap: pretty;
  }
  .pull-quote-attr {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 0.78125rem;
    font-style: normal;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* ─── Tiles header ─────────────────────────────────────── */
  .tiles-header {
    border-top: 1px solid var(--rule);
    padding: 32px 0 20px;
    display: flex;
    grid-template-columns: none;
  }
  .tiles-header .eyebrow {
    margin-bottom: 0;
  }

  /* ─── Tiles ────────────────────────────────────────────── */
  /* Each tile-row IS the link. Sidenote sits in column 4 of the same grid,
     so the whole row is one click target with one continuous hover state. */
  .tiles {
    padding: 0 0 48px;
  }
  .tile-row {
    position: relative;
    display: grid;
    /* Three columns, not four: the link label and the durable tag stack inside
       one right-hand column. The old 110px column held the raw href, which
       wrapped mid-path and orphaned the arrow onto its own line. */
    grid-template-columns: 36px 1fr 220px;
    gap: 22px;
    padding: 22px 12px;
    margin: 0 -12px;
    align-items: baseline;
    border-radius: 4px;
    color: inherit;
    transition: background 160ms ease;
  }
  /* Rule lines as pseudo-elements, inset 12px so they align with the frame
     content edge (matching the section borders above/below) — not with the
     row's outset hover background. */
  .tile-row::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 1px;
    background: var(--rule);
  }
  /* The next section brings its own border-top, so suppressing
     the last row's bottom rule prevents two near-adjacent lines with whitespace
     between them. */
  .tile-row:last-child::after {
    display: none;
  }
  .tile-row:first-child::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 1px;
    background: var(--rule);
  }
  .tile-row:hover {
    background: var(--bg-raise);
  }
  .tile-row:hover .tile-heading {
    color: var(--accent);
  }
  .tile-row:hover .tile-arrow {
    transform: translateX(2px);
  }
  .tile-num {
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--fg-nav);
  }
  .tile-heading {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.78125rem;
    letter-spacing: -0.018em;
    color: var(--fg);
    margin-bottom: 4px;
    transition: color 160ms ease;
  }
  .tile-tagline {
    color: var(--muted);
    font-style: italic;
    font-weight: 400;
    font-size: 1.15625rem;
  }
  .tile-body {
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--fg);
    opacity: 0.78;
    text-wrap: pretty;
  }
  /* One-line stack, set like the other mono meta lines on the page. */
  .tile-stack {
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 0.84375rem;
    line-height: 1.5;
    color: var(--fg-nav);
  }
  .tile-arrow {
    font-family: var(--mono);
    font-size: 0.9375rem;
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
    transition: transform 160ms ease;
    transform-origin: right center;
  }

  .tile-side {
    /* column 3 of the .tile-row grid (the row IS the link). Label on top,
       durable tag under it, both flush to the right edge. */
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    font-family: var(--mono);
    font-size: 0.90625rem;
    line-height: 1.65;
    color: var(--fg-nav);
    text-align: right;
  }
  .sidenote-live {
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .sidenote-durable {
    color: var(--fg-nav);
  }
  .live-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--live-dot);
    margin-right: 7px;
    box-shadow: 0 0 4px rgba(200, 174, 106, 0.4);
  }

  /* ─── Speaking ─────────────────────────────────────────── */
  /* Full frame width: nothing occupies the right column here, so capping
     at the 740px body width just wrapped the text early. */
  .speaking-section .main-col {
    grid-column: 1 / -1;
  }
  /* List styles live in src/components/PastTalks.astro. */
  .speaking-more {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 0.9375rem;
  }
  .speaking-more a {
    color: var(--accent);
    font-weight: 500;
  }
  .speaking-more a:hover {
    color: var(--fg);
  }

  /* ─── Latest memos ────────────────────────────────────── */
  /* Full frame width, like Speaking. Each row is one link with the .tile-row
     hover mechanics: the background outsets 12px past the frame edge. */
  .memos-section .main-col {
    grid-column: 1 / -1;
  }
  .lm-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .lm-list > li {
    border-bottom: 1px solid var(--rule);
  }
  .lm-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto auto;
    gap: 22px;
    align-items: center;
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: 4px;
    transition: background 160ms ease;
  }
  /* A memo without a cover renders no empty box: the title takes column 1. */
  .lm-row.no-cover {
    grid-template-columns: minmax(0, 1fr) auto auto;
    padding: 14px 12px;
  }
  .lm-row:hover {
    background: var(--bg-raise);
  }
  .lm-row:hover .lm-title {
    color: var(--accent);
  }
  .lm-row:hover .lm-mini {
    border-color: var(--accent);
  }
  .lm-mini {
    margin: 0;
    border: 1px solid var(--rule-2);
    border-radius: 3px;
    overflow: hidden;
    background: var(--bg-raise);
    transition: border-color 160ms ease;
  }
  .lm-mini img {
    display: block;
    width: 100%;
    height: auto;
  }
  .lm-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.375rem;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--fg);
    text-wrap: balance;
    transition: color 160ms ease;
  }
  .lm-title :global(.cmd) {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.84em;
    letter-spacing: -0.01em;
  }
  .lm-date,
  .lm-min {
    font-family: var(--mono);
    font-size: 0.84375rem;
    white-space: nowrap;
  }
  .lm-date {
    color: var(--fg-nav);
  }
  .lm-min {
    color: var(--muted);
  }
  /* Desktop shows the minutes in their own cell; phone folds them into the
     date line. */
  .lm-date-min {
    display: none;
  }

  /* ─── Availability ─────────────────────────────────────── */
  /* Header row (eyebrow + pill), the ruled strip with the full-time line,
     then the four shapes as a 2×2 grid, then the CTA. */
  .availability {
    display: block;
    padding: 36px 0 44px;
  }
  .avail-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .avail-head .eyebrow {
    margin-bottom: 0;
  }
  .status-pill {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--status-fg);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    background: var(--status-bg);
    border: 1px solid var(--rule-2);
  }
  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--status-fg);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(166, 212, 159, 0.53);
  }
  .avail-strip {
    margin-bottom: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .avail-fit {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.375rem;
    color: var(--fg);
  }
  /* Set in the line's own colour (as in the reference); the arrow carries the
     affordance, hover turns it accent like the rows above. */
  .avail-fit a {
    transition: color 160ms ease;
  }
  .avail-fit a:hover {
    color: var(--accent);
  }
  .avail-where {
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--fg);
    opacity: 0.86;
  }

  /* Engagement shapes: the page's one conversion surface, so it answers
     "what would I even hire him for?" before asking for the email. */
  .shapes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .shapes li {
    background: var(--bg-raise);
    border-radius: 6px;
    padding: 18px 22px;
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    text-wrap: pretty;
  }
  /* Name on its own line above its one-line description. */
  .shape-name {
    display: block;
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .shapes a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }

  .cta {
    margin-top: 28px;
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cta-link {
    font-family: var(--mono);
    font-size: 0.96875rem;
    color: var(--accent);
    padding: 9px 14px;
    border: 1px solid var(--accent);
    border-radius: 3px;
    white-space: nowrap;
    transition:
      background 160ms ease,
      color 160ms ease;
  }
  .cta-link:hover {
    background: var(--accent);
    color: var(--bg-base);
  }

  /* ─── Responsive: mobile ≤640px ────────────────────────── */
  /* The 3-track grid needs 740 + 28px of track, but .frame only offers
