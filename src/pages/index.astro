---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';

// ─── Live (build-time) values ────────────────────────────────────
// Regenerated on every Coolify rebuild. If these go stale, redeploy.
const buildDate = new Date().toISOString().slice(0, 10); // YYYY-MM-DD

// ─── Tile data ───────────────────────────────────────────────────
// Ranked the way a fractional/contract buyer reads them: the shipped product
// first, the machinery that ships it second, the public artefact third.
const tiles = [
  {
    n: '01',
    title: 'Education SaaS',
    tagline: 'the product this workflow ships',
    body: 'A multi-tenant education platform, in production with a paying customer. Hexagonal modular monolith on PHP 8.4 / Symfony 7.4, full CQRS at the UseCase layer, and enforcement layers every merge has to pass.',
    href: '/projects#education-saas',
    linkLabel: 'how it is built',
    live: null,
    durable: 'in production since 2026-03',
  },
  {
    n: '02',
    title: 'Pipeforge',
    tagline: 'the delivery machinery',
    body: 'My Claude Code orchestration plugin over a PostgreSQL MCP backend: templated commands, agent dispatch, verification and fidelity audits. Screenshot walkthrough of real runs.',
    href: '/projects/pipeforge',
    linkLabel: 'walkthrough',
    live: null,
    durable: 'private tool · used daily',
  },
  {
    n: '03',
    title: 'ProfitOfExile',
    tagline: 'open source, in the wild',
    body: 'An open-source desktop overlay and web app for the Path of Exile community, built across Go / SvelteKit / Tauri, with one Go backend feeding two delivery surfaces. Adopted by the community after creator coverage.',
    href: '/projects#profitofexile',
    linkLabel: 'project details',
    live: null,
    durable: 'MIT · community-adopted',
  },
];
---

<Base
  title="Sebastian Rogala — AI Delivery Engineer"
  description="I direct AI agents to build software — product intent in, verified software out. Currently shipping a multi-tenant Education SaaS in production, an open-source community tool, and Pipeforge, my Claude Code orchestration infrastructure."
>
  <TopNav current="home" />

  <main class="frame">
    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="hero">
      <h1>Sebastian Rogala</h1>
      <p class="tagline">AI Delivery Engineer</p>
      <p class="subline">
        I direct AI agents to build software — product intent in, verified software out.
      </p>
    </section>

    <!-- ── Pitch + pull-quote ────────────────────────────────── -->
    <section class="section pitch-section">
      <div class="main-col">
        <h2 class="eyebrow">What I do</h2>
        <p class="pitch">
          I design AI-directed delivery systems. Over a decade of broad software engineering
          experience; fully AI-directed since early 2026. Currently shipping a multi-tenant
          Education SaaS in production, an open-source community tool, and Pipeforge, my Claude
          Code orchestration and MCP-backed workflow infrastructure.
        </p>
        <p class="pitch-detail">
          In practice I turn product intent into specs agents can build from, decompose the work
          for them, and wrap verification loops around it. Verification is structural: review
          agents, audit tools, hooks, durable state, source-cited knowledge. Then I check the
          shipped outcome against what was actually asked for.
        </p>
      </div>
      <div class="side-col">
        <div class="pull-quote">
          “AI failures are spec gaps, not agent shortcomings.”
          <div class="pull-quote-attr">— how I read most agent failures</div>
        </div>
      </div>
    </section>

    <!-- ── How it holds up ───────────────────────────────────── -->
    <!-- Qualitative by design: named, falsifiable, binding mechanisms instead
         of counts a stranger cannot price. /projects carries the detail. -->
    <section class="section gates-section">
      <div class="main-col">
        <h2 class="eyebrow">How it holds up</h2>
        <p class="gates">
          Every merge passes gates I wrote for this codebase. A cross-tenant query fails static
          analysis, and so does comparing entity identities by object. Dependency direction gets
          checked on two axes, architectural layers and the module graph, and a UI lint enforces
          the design system's own conventions. The module-graph baseline is
          <strong>shrink-only</strong>: it can go down, never up. None of it is a dashboard.
          Each one blocks the merge.
        </p>
        <p class="gates-meta">
          All green as of 2026-07-31. <a href="/projects#how-quality-gets-enforced">what each layer does →</a>
        </p>
      </div>
    </section>

    <!-- ── Tiles header ─────────────────────────────────────── -->
    <section class="section tiles-header">
      <h2 class="eyebrow">Things I'm working on / pointing to</h2>
    </section>

    <!-- ── Work tiles ────────────────────────────────────────── -->
    <section class="tiles">
      {
        tiles.map((t) => (
          <a href={t.href} class="tile-row tile-link">
            <div class="tile-num">{t.n}</div>
            <div class="tile-content">
              <div class="tile-heading">
                {t.title}
                <span class="tile-tagline"> — {t.tagline}</span>
              </div>
              <div class="tile-body">{t.body}</div>
            </div>
            <div class="tile-side">
              <div class="tile-arrow">{t.linkLabel} →</div>
              {t.live && (
                <div class="sidenote-live">
                  <span class="live-dot" />
                  {t.live}
                </div>
              )}
              <div class="sidenote-durable">{t.durable}</div>
            </div>
          </a>
        ))
      }
    </section>

    <!-- ── Speaking ──────────────────────────────────────────── -->
    <section class="section speaking-section">
      <div class="main-col">
        <h2 class="eyebrow">Speaking</h2>
        <ul class="speaking">
          <li>
            <a href="https://www.meetup.com/rg-dev/events/316407562" target="_blank" rel="noopener"
              >rg-dev Meetup</a
            >, 23.09.2026 (upcoming) — <em>From Directing Agents to Autonomous Delivery: One Skill,
            the Whole Loop</em>
          </li>
          <li>
            Agentic Jams (Rzeszów, first edition), 17.06.2026 — <em>How I stopped compacting —
            MCP as durable memory for an AI delivery pipeline</em>
          </li>
          <li>
            <a href="https://www.meetup.com/rg-dev/events/314750399" target="_blank" rel="noopener"
              >rg-dev Meetup</a
            >, 27.05.2026 — <em>From Prompting to Directing Agents: Practical AI-Native Development</em>
          </li>
          <li>
            Xebia Internal Conference, Nov 2023 — <em>GitHub Actions &amp; Continuous Delivery on
            Shared Hosting</em>
          </li>
        </ul>
      </div>
    </section>

    <!-- ── Availability (no fixed quarter — just an "open" signal). ─ -->
    <section class="section availability" id="availability">
      <div class="avail-left">
        <h2 class="eyebrow">Availability</h2>
        <div class="status-pill">
          <span class="status-dot"></span>
          open
        </div>
      </div>
      <div class="avail-right">
        <p class="avail-text">
          I'm open to fractional / contract AI-delivery work, advisory, and team workshops or training
          on AI-directed development. Full-time for the right fit. Based in Rzeszów, Poland
          (UTC+2).
        </p>
        <ul class="shapes">
          <li>
            <span class="shape-name">Fractional delivery</span> — I run delivery on your codebase:
            I turn intent into specs, decompose the work for agents, and build the verification
            that makes the output reviewable.
          </li>
          <li>
            <span class="shape-name">Advisory</span> — I look at an AI-directed setup you already
            have and say where the review bottleneck actually sits, and what to enforce
            structurally instead of by discipline.
          </li>
          <li>
            <span class="shape-name">Team workshop / training</span> — how a team moves from
            prompting to directing agents, with a codebase that ships to a paying customer as the
            worked example.
          </li>
        </ul>
        <p class="cta">
          <a class="cta-link" href="mailto:sebrogala@gmail.com?subject=Fractional%20%2F%20contract%20work">
            Tell me what you're shipping →
          </a>
          <span class="cta-note">The workflow is usually the unfamiliar part. Happy to walk through it.</span>
        </p>
        <!-- TODO: link a CV / one-pager here. It is the artefact a hiring manager
             forwards internally, and nothing is published to link to yet. -->
      </div>
    </section>

    <!-- ── Footer ─────────────────────────────────────────── -->
    <footer class="footer">
      <div class="footer-links">
        <a href="mailto:sebrogala@gmail.com">sebrogala@gmail.com</a>
        <span class="sep">·</span>
        <a href="https://linkedin.com/in/sebrogala" target="_blank" rel="noopener">linkedin.com/in/sebrogala</a>
        <span class="sep">·</span>
        <a href="https://github.com/SebRogala" target="_blank" rel="noopener">github.com/SebRogala</a>
      </div>
      <div class="footer-meta">made with Claude Design · latest build {buildDate}</div>
    </footer>
  </main>
</Base>

<style>
  /* ─── Layout constants ────────────────────────────────────── */
  /* Frame 1140 max · Body 660 + 28 gutter + 1fr right column.
     Pull-quote constrained by .pull-quote max-width; tile sidenotes right-align. */

  .frame {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Topnav + mobile-subnav styles live in src/components/TopNav.astro. */

  /* `.sep` is also used inside the page footer below — keep as page-level rule. */
  .sep {
    color: var(--rule-2);
  }

  /* ─── Hero ─────────────────────────────────────────────── */
  .hero {
    padding: 60px 0 24px;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 56px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 14px;
  }
  .tagline {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  /* The sub-line carries the category (Rule 8: it has to land from the grammar
     of the first sentence, not from the label above it), so it is set at
     reading weight rather than as a caption. */
  .subline {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.5;
    color: var(--fg);
    max-width: 640px;
    text-wrap: pretty;
  }

  /* ─── Pitch section ────────────────────────────────────── */
  .section {
    padding: 40px 0 52px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 740px 28px 1fr;
  }
  .pitch-section .main-col {
    grid-column: 1;
  }
  .pitch-section .side-col {
    grid-column: 3;
    padding-top: 30px;
  }

  /* `.eyebrow` is an <h2> everywhere it appears — the section headings were
     previously non-semantic divs, so the page had one <h1> and no <h2> at all. */
  .eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .pitch {
    font-family: var(--serif);
    /* Pitch weight bumped from 400 → 500 to anchor the page (one of three metric-reduction tweaks) */
    font-weight: 500;
    font-size: 22px;
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
  }

  .pitch-detail {
    margin-top: 18px;
    font-family: var(--sans);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--fg);
    opacity: 0.86;
    text-wrap: pretty;
  }

  .pull-quote {
    /* width capped + pushed to the right of column 3 so the pull-quote sits
       at the same right-edge as the tile sidenotes below — visual consistency
       across the page. */
    max-width: 240px;
    margin-left: auto;
    border-left: 2px solid var(--accent);
    padding-left: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--fg);
    text-wrap: pretty;
  }
  .pull-quote-attr {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-style: normal;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* ─── Gates ────────────────────────────────────────────── */
  .gates-section .main-col {
    grid-column: 1;
  }
  .gates {
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg);
    text-wrap: pretty;
  }
  .gates strong {
    font-weight: 600;
    color: var(--accent);
  }
  .gates-meta {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg-nav);
  }
  .gates-meta a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }

  /* ─── Tiles header ─────────────────────────────────────── */
  .tiles-header {
    border-top: 1px solid var(--rule);
    padding: 32px 0 20px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    grid-template-columns: none;
  }
  .tiles-header .eyebrow {
    margin-bottom: 0;
  }

  /* ─── Tiles ────────────────────────────────────────────── */
  /* Each tile-row IS the link. Sidenote sits in column 4 of the same grid,
     so the whole row is one click target with one continuous hover state. */
  .tiles {
    padding: 0 0 48px;
  }
  .tile-row {
    position: relative;
    display: grid;
    /* Three columns, not four: the link label and the durable tag stack inside
       one right-hand column. The old 110px column held the raw href, which
       wrapped mid-path and orphaned the arrow onto its own line. */
    grid-template-columns: 36px 1fr 220px;
    gap: 22px;
    padding: 22px 12px;
    margin: 0 -12px;
    align-items: baseline;
    border-radius: 4px;
    color: inherit;
    transition: background 160ms ease;
  }
  /* Rule lines as pseudo-elements, inset 12px so they align with the frame
     content edge (matching the section borders above/below) — not with the
     row's outset hover background. */
  .tile-row::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 1px;
    background: var(--rule);
  }
  /* The next section (.availability) brings its own border-top, so suppressing
     the last row's bottom rule prevents two near-adjacent lines with whitespace
     between them. */
  .tile-row:last-child::after {
    display: none;
  }
  .tile-row:first-child::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 1px;
    background: var(--rule);
  }
  .tile-row:hover {
    background: var(--bg-raise);
  }
  .tile-row:hover .tile-heading {
    color: var(--accent);
  }
  .tile-row:hover .tile-arrow {
    transform: translateX(2px);
  }
  .tile-num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg-nav);
  }
  .tile-heading {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.018em;
    color: var(--fg);
    margin-bottom: 4px;
    transition: color 160ms ease;
  }
  .tile-tagline {
    color: var(--muted);
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
  }
  .tile-body {
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--fg);
    opacity: 0.78;
    text-wrap: pretty;
  }
  .tile-arrow {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
    transition: transform 160ms ease;
    transform-origin: right center;
  }

  .tile-side {
    /* column 3 of the .tile-row grid (the row IS the link). Label on top,
       durable tag under it, both flush to the right edge. */
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--fg-nav);
    text-align: right;
  }
  .sidenote-live {
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .sidenote-durable {
    color: var(--fg-nav);
  }
  .live-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--live-dot);
    margin-right: 7px;
    box-shadow: 0 0 4px rgba(200, 174, 106, 0.4);
  }

  /* ─── Speaking ─────────────────────────────────────────── */
  .speaking-section .main-col {
    grid-column: 1;
  }
  .speaking {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg);
  }
  .speaking li {
    padding-left: 16px;
    position: relative;
    text-wrap: pretty;
  }
  .speaking li + li {
    margin-top: 8px;
  }
  .speaking li::before {
    content: '·';
    position: absolute;
    left: 2px;
    color: var(--muted);
  }
  .speaking em {
    color: var(--muted);
    font-style: italic;
  }
  .speaking a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }

  /* ─── Availability ─────────────────────────────────────── */
  .availability {
    padding: 36px 0 44px;
    grid-template-columns: 180px 1fr;
    gap: 24px;
  }
  .avail-left {
    grid-column: 1;
  }
  .availability .eyebrow {
    margin-bottom: 12px;
  }
  .status-pill {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--status-fg);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    background: var(--status-bg);
    border: 1px solid var(--rule-2);
  }
  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--status-fg);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(166, 212, 159, 0.53);
  }
  .avail-right {
    grid-column: 2;
  }
  .avail-text {
    font-family: var(--serif);
    /* Bumped to weight 500 to match pitch (consistent identity hierarchy) */
    font-weight: 500;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--fg);
    text-wrap: pretty;
  }

  /* Engagement shapes: the page's one conversion surface, so it answers
     "what would I even hire him for?" before asking for the email. */
  .shapes {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    border-top: 1px solid var(--rule);
  }
  .shapes li {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg);
    opacity: 0.86;
    text-wrap: pretty;
  }
  .shape-name {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }

  .cta {
    margin-top: 22px;
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cta-link {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--accent);
    padding: 9px 14px;
    border: 1px solid var(--accent);
    border-radius: 3px;
    transition:
      background 160ms ease,
      color 160ms ease;
  }
  .cta-link:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .cta-note {
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ─── Footer ───────────────────────────────────────────── */
  .footer {
    padding: 22px 0 36px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg);
  }
  .footer-links {
    display: flex;
    gap: 22px;
  }
  .footer-links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }
  .footer-meta {
    color: var(--fg-nav);
    font-size: 12.5px;
  }

  /* ─── Responsive: mobile ≤640px ────────────────────────── */
  @media (max-width: 640px) {
    .frame {
      padding: 0 22px;
    }

    .hero {
      padding: 36px 0 18px;
    }
    .hero h1 {
      font-size: 36px;
      margin-bottom: 10px;
    }
    .tagline {
      font-size: 11.5px;
      margin-bottom: 10px;
    }
    .subline {
      font-size: 16px;
    }

    .section {
      grid-template-columns: 1fr;
      padding: 24px 0;
    }
    .pitch-section .side-col {
      /* Reset desktop's grid-column: 3 so the pull-quote stacks under the
         pitch in the single-column mobile layout. */
      grid-column: 1;
      padding-top: 16px;
      border-top: 1px dashed var(--rule-2);
      margin-top: 16px;
    }
    .pitch {
      font-size: 17px;
    }
    .gates {
      font-size: 15px;
    }
    .pitch-detail,
    .speaking {
      font-size: 14.5px;
    }
    .pull-quote {
      font-size: 14px;
      /* Desktop pushes pull-quote right with margin-left: auto so it lines up
         with tile sidenotes. On mobile (single-column stack) we want it
         left-aligned in the full-width column. */
      max-width: none;
      margin-left: 0;
    }

    .tiles-header {
      padding: 24px 0 16px;
    }

    .tile-row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 18px 0;
      margin: 0;
    }
    /* On mobile the row has no negative margin, so the pseudo-element rule
       lines should sit at the row's full width (left:0 right:0) — not inset
       12px the way they do on desktop. */
    .tile-row::after,
    .tile-row:first-child::before {
      left: 0;
      right: 0;
    }
    .tile-num {
      font-size: 11px;
    }
    .tile-heading {
      font-size: 22px;
    }
    .tile-body {
      font-size: 14px;
    }
    .tile-side {
      padding: 8px 0 0;
      border-top: 1px dashed var(--rule-2);
      margin-top: 12px;
      align-items: flex-start;
      text-align: left;
    }
    .sidenote-live {
      justify-content: flex-start;
    }

    .availability {
      grid-template-columns: 1fr;
      padding: 24px 0;
    }
    .avail-right {
      /* Reset desktop's grid-column: 2 so the block stacks under the
         eyebrow + pill in the single-column mobile layout. */
      grid-column: 1;
    }
    .avail-text {
      font-size: 16px;
    }
    .shapes li {
      font-size: 14px;
    }
    .cta {
      flex-direction: column;
      gap: 12px;
