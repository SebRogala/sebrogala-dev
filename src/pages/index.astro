---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import PastTalks from '../components/PastTalks.astro';
import { omsLive, omsPhase, omsScopeVerb, capitalize } from '../lib/oms';

// ─── Live (build-time) values ────────────────────────────────────
// Regenerated on every Coolify rebuild. If these go stale, redeploy.
// DD.MM.YYYY: the site writes every visible date numerically, day first.
const now = new Date();
const pad = (n: number) => String(n).padStart(2, '0');
const buildDate = `${pad(now.getUTCDate())}.${pad(now.getUTCMonth() + 1)}.${now.getUTCFullYear()}`;

// ─── Tile data ───────────────────────────────────────────────────
// Ranked the way a buyer reads them: shipped and in-progress custom software
// first, the machinery that ships it second, the public artefact third.
const tiles = [
  {
    n: '01',
    title: 'Education SaaS',
    tagline: 'built for its first client',
    body: 'Multi-tenant education CRM. Hexagonal modular monolith on Symfony, gated on every merge.',
    stack: 'PHP/Symfony · PostgreSQL · Redis · Twig',
    href: '/projects#education-saas',
    linkLabel: 'details',
    live: null,
    durable: 'in production since 03.2026',
  },
  {
    n: '02',
    title: 'OMS / backoffice',
    tagline: 'client project',
    body: `Order management for a building-materials e-shop. ${capitalize(omsScopeVerb)} the most-used ~80% of a legacy admin.`,
    stack: 'Symfony · Symfony UX · Tailwind · PostgreSQL',
    href: '/projects#oms-backoffice',
    linkLabel: 'details',
    live: null,
    durable: omsPhase,
  },
  {
    n: '03',
    title: 'Pipeforge + Fleetforge',
    tagline: 'delivery tooling',
    body: 'Orchestration for Claude Code and Codex on a PostgreSQL MCP server, run by written rules the agents must follow for planning, tests and review. Every project here ships through it.',
    stack: 'Claude Code · Codex · MCP · PostgreSQL',
    href: '/projects/pipeforge',
    linkLabel: 'walkthrough',
    live: null,
    durable: 'private · used daily',
  },
  {
    n: '04',
    title: 'ProfitOfExile',
    tagline: 'side project',
    body: 'Windows companion app for Path of Exile that helps players decide using live market prices.',
    stack: 'Go · Rust/Tauri · SvelteKit · TimescaleDB · OCR',
    href: '/projects#profitofexile',
    linkLabel: 'details',
    live: null,
    durable: 'GPL-3.0 · community-adopted',
  },
];
---

<Base
  title="Sebastian Rogala, AI-First Software Engineer | AI-native SDLC"
  description="Software engineer who builds by directing AI agents and verifying the outcome. Talks, workshops and consulting on AI-native delivery. Current work: an education SaaS in production, a client OMS, and Pipeforge and Fleetforge."
>
  <TopNav current="home" />

  <main class="frame">
    <!-- ── Hero: text left, illustration right on desktop ────── -->
    <div class="hero-row">
    <section class="hero">
      <h1>Sebastian Rogala</h1>
      <p class="tagline">AI-First Software Engineer | AI-native SDLC</p>
      <p class="subline">AI agents build the software. I direct them and verify it works.</p>
    </section>

    <!-- ── Fan-out illustration (no caption; alt carries it) ─── -->
    <div class="hero-art">
      <img
        src="/site-hero-fleet-v3.webp"
        width="1536"
        height="1024"
        alt="Illustration: Sebastian facing a coordinator agent that fans out to supervisors, orchestrators and many working agents."
      />
    </div>
    </div>

    <!-- ── Pitch + pull-quote ────────────────────────────────── -->
    <section class="section pitch-section">
      <div class="main-col">
        <h2 class="eyebrow">What I do</h2>
        <p class="pitch">I'm a software engineer with over a decade of broad experience, fully AI-directed since early 2026. I build software by directing AI agents and verifying the outcome. I also give talks, run workshops and consult on AI-native delivery. Beyond code I explore other uses of AI too, like local Whisper turning client meetings into tasks and Demucs separating audio stems.</p>
      </div>
      <div class="side-col">
        <div class="pull-quote">
          “AI failures are spec gaps, not agent shortcomings.”
          <div class="pull-quote-attr">how I read most agent failures</div>
        </div>
      </div>
    </section>

    <!-- ── Tiles header ─────────────────────────────────────── -->
    <section class="section tiles-header">
      <h2 class="eyebrow">Current work</h2>
    </section>

    <!-- ── Work tiles ────────────────────────────────────────── -->
    <section class="tiles">
      {
        tiles.map((t) => (
          <a href={t.href} class="tile-row tile-link">
            <div class="tile-num">{t.n}</div>
            <div class="tile-content">
              <div class="tile-heading">
                {t.title}
                <span class="tile-tagline"> · {t.tagline}</span>
              </div>
              <div class="tile-body">{t.body}</div>
              <div class="tile-stack">{t.stack}</div>
            </div>
            <div class="tile-side">
              <div class="tile-arrow">{t.linkLabel} →</div>
              {t.live && (
                <div class="sidenote-live">
                  <span class="live-dot" />
                  {t.live}
                </div>
              )}
              <div class="sidenote-durable">{t.durable}</div>
            </div>
          </a>
        ))
      }
    </section>

    <!-- ── Speaking ──────────────────────────────────────────── -->
    <section class="section speaking-section">
      <div class="main-col">
        <h2 class="eyebrow">Speaking</h2>
        <PastTalks />
      </div>
    </section>

    <!-- ── Availability (no fixed quarter — just an "open" signal). ─ -->
    <section class="section availability" id="availability">
      <div class="avail-left">
        <h2 class="eyebrow">Availability</h2>
        <div class="status-pill">
          <span class="status-dot"></span>
          open
        </div>
      </div>
      <div class="avail-right">
        <ul class="shapes">
          <li>
            <span class="shape-name">Custom software projects</span>
            From defining the need to launch and handover, like the <a href="/projects#education-saas">Education SaaS</a>{omsLive && <> and the <a href="/projects#oms-backoffice">OMS</a></>}.
          </li>
          <li>
            <span class="shape-name">Fractional delivery</span>
            I run delivery on your codebase.
          </li>
          <li>
            <span class="shape-name">Advisory</span>
            Where your review bottleneck sits, and what to enforce structurally.
          </li>
          <li>
            <span class="shape-name">Workshops and training</span>
            How a team moves from prompting to directing agents. <a href="/talks">topics →</a>
          </li>
        </ul>
        <p class="avail-note">Full-time for the right fit. Based in Rzeszów, Poland.</p>
        <p class="cta">
          <a class="cta-link" href="mailto:sebrogala@gmail.com?subject=Custom%20software%20%2F%20delivery%20work">
            Tell me what you're shipping →
          </a>
        </p>
      </div>
    </section>

    <!-- ── Footer ─────────────────────────────────────────── -->
    <footer class="footer">
      <div class="footer-links">
        <a href="mailto:sebrogala@gmail.com">sebrogala@gmail.com</a>
        <span class="sep">·</span>
        <a href="https://linkedin.com/in/sebrogala" target="_blank" rel="noopener">linkedin.com/in/sebrogala</a>
        <span class="sep">·</span>
        <a href="https://github.com/SebRogala" target="_blank" rel="noopener">github.com/SebRogala</a>
      </div>
      <div class="footer-meta">made with Claude Design · latest build {buildDate}</div>
    </footer>
  </main>
</Base>

<style>
  /* ─── Layout constants ────────────────────────────────────── */
  /* Frame 1140 max · Body 660 + 28 gutter + 1fr right column.
     Pull-quote constrained by .pull-quote max-width; tile sidenotes right-align. */

  .frame {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Topnav + mobile-subnav styles live in src/components/TopNav.astro. */

  /* `.sep` is also used inside the page footer below — keep as page-level rule. */
  .sep {
    color: var(--rule-2);
  }

  /* ─── Hero ─────────────────────────────────────────────── */
  .hero {
    padding: 60px 0 24px;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 3.84375rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 14px;
  }
  .tagline {
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  /* The sub-line carries the category (Rule 8: it has to land from the grammar
     of the first sentence, not from the label above it), so it is set at
     reading weight rather than as a caption. */
  .subline {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.375rem;
    line-height: 1.5;
    color: var(--fg);
    text-wrap: pretty;
  }

  /* ─── Hero illustration ────────────────────────────────── */
  /* Capped at the 740px main track and at 60vh so the whole fan-out stays
     visible, scaled, never cropped. The WebP carries its own alpha: the painted
     background is keyed out (soft, luminance-based, with the figure kept
     opaque and the frame edges faded), so the page gradient shows through
     and no box or CSS edge mask is needed. */
  .hero-art {
    padding: 0 0 32px;
  }
  .hero-art img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(100%, 740px);
    max-height: 60vh;
    object-fit: contain;
  }

  /* From 900px the hero text (45%) and the illustration (55%) sit side by
     side, so the image fills the right of the frame instead of a row of its
     own and "What I do" lands above the fold at 1440x900. Below 900px they
     stack as before. The h1 is 3.5rem here (3.84rem stacked) because the
     name did not fit the 45% column on one line. */
  @media (min-width: 900px) {
    .hero-row {
      display: grid;
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      column-gap: 32px;
      align-items: center;
      padding: 48px 0 32px;
    }
    .hero-row .hero,
    .hero-row .hero-art {
      padding: 0;
    }
    .hero-row .hero h1 {
      font-size: 3.5rem;
    }
    .hero-row .hero-art img {
      max-width: 100%;
    }
  }

  /* ─── Pitch section ────────────────────────────────────── */
  .section {
    padding: 40px 0 52px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 740px) 28px 1fr;
  }
  .pitch-section .main-col {
    grid-column: 1;
  }
  .pitch-section .side-col {
    grid-column: 3;
    padding-top: 30px;
  }

  /* On this page `.eyebrow` is an <h2>: the section headings were previously
     non-semantic divs, so the page had one <h1> and no <h2> at all. On the other
     pages `.eyebrow` is a kicker <div> above the <h1> and stays caption-sized. */
  .eyebrow {
    font-family: var(--mono);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .pitch {
    font-family: var(--serif);
    /* Pitch weight bumped from 400 → 500 to anchor the page (one of three metric-reduction tweaks) */
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
  }

  .pull-quote {
    /* width capped + pushed to the right of column 3 so the pull-quote sits
       at the same right-edge as the tile sidenotes below — visual consistency
       across the page. */
    max-width: 240px;
    margin-left: auto;
    border-left: 2px solid var(--accent);
    padding-left: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--fg);
    text-wrap: pretty;
  }
  .pull-quote-attr {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 0.78125rem;
    font-style: normal;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* ─── Tiles header ─────────────────────────────────────── */
  .tiles-header {
    border-top: 1px solid var(--rule);
    padding: 32px 0 20px;
    display: flex;
    grid-template-columns: none;
  }
  .tiles-header .eyebrow {
    margin-bottom: 0;
  }

  /* ─── Tiles ────────────────────────────────────────────── */
  /* Each tile-row IS the link. Sidenote sits in column 4 of the same grid,
     so the whole row is one click target with one continuous hover state. */
  .tiles {
    padding: 0 0 48px;
  }
  .tile-row {
    position: relative;
    display: grid;
    /* Three columns, not four: the link label and the durable tag stack inside
       one right-hand column. The old 110px column held the raw href, which
       wrapped mid-path and orphaned the arrow onto its own line. */
    grid-template-columns: 36px 1fr 220px;
    gap: 22px;
    padding: 22px 12px;
    margin: 0 -12px;
    align-items: baseline;
    border-radius: 4px;
    color: inherit;
    transition: background 160ms ease;
  }
  /* Rule lines as pseudo-elements, inset 12px so they align with the frame
     content edge (matching the section borders above/below) — not with the
     row's outset hover background. */
  .tile-row::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 1px;
    background: var(--rule);
  }
  /* The next section (.availability) brings its own border-top, so suppressing
     the last row's bottom rule prevents two near-adjacent lines with whitespace
     between them. */
  .tile-row:last-child::after {
    display: none;
  }
  .tile-row:first-child::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 1px;
    background: var(--rule);
  }
  .tile-row:hover {
    background: var(--bg-raise);
  }
  .tile-row:hover .tile-heading {
    color: var(--accent);
  }
  .tile-row:hover .tile-arrow {
    transform: translateX(2px);
  }
  .tile-num {
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--fg-nav);
  }
  .tile-heading {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.78125rem;
    letter-spacing: -0.018em;
    color: var(--fg);
    margin-bottom: 4px;
    transition: color 160ms ease;
  }
  .tile-tagline {
    color: var(--muted);
    font-style: italic;
    font-weight: 400;
    font-size: 1.15625rem;
  }
  .tile-body {
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--fg);
    opacity: 0.78;
    text-wrap: pretty;
  }
  /* One-line stack, set like the other mono meta lines on the page. */
  .tile-stack {
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 0.84375rem;
    line-height: 1.5;
    color: var(--fg-nav);
  }
  .tile-arrow {
    font-family: var(--mono);
    font-size: 0.9375rem;
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
    transition: transform 160ms ease;
    transform-origin: right center;
  }

  .tile-side {
    /* column 3 of the .tile-row grid (the row IS the link). Label on top,
       durable tag under it, both flush to the right edge. */
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    font-family: var(--mono);
    font-size: 0.90625rem;
    line-height: 1.65;
    color: var(--fg-nav);
    text-align: right;
  }
  .sidenote-live {
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .sidenote-durable {
    color: var(--fg-nav);
  }
  .live-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--live-dot);
    margin-right: 7px;
    box-shadow: 0 0 4px rgba(200, 174, 106, 0.4);
  }

  /* ─── Speaking ─────────────────────────────────────────── */
  /* Full frame width: nothing occupies the right column here, so capping
     at the 740px body width just wrapped the text early. */
  .speaking-section .main-col {
    grid-column: 1 / -1;
  }
  /* List styles live in src/components/PastTalks.astro. */

  /* ─── Availability ─────────────────────────────────────── */
  .availability {
    padding: 36px 0 44px;
    grid-template-columns: 180px 1fr;
    gap: 24px;
  }
  .avail-left {
    grid-column: 1;
  }
  .availability .eyebrow {
    margin-bottom: 12px;
  }
  .status-pill {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--status-fg);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    background: var(--status-bg);
    border: 1px solid var(--rule-2);
  }
  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--status-fg);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(166, 212, 159, 0.53);
  }
  .avail-right {
    grid-column: 2;
  }
  .avail-note {
    margin-top: 18px;
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    opacity: 0.86;
  }

  /* Engagement shapes: the page's one conversion surface, so it answers
     "what would I even hire him for?" before asking for the email. */
  .shapes {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .shapes li {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
    opacity: 0.86;
    text-wrap: pretty;
  }
  /* Name on its own line above its one-line description. */
  .shape-name {
    display: block;
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--accent);
  }
  .shapes a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }

  .cta {
    margin-top: 22px;
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cta-link {
    font-family: var(--mono);
    font-size: 0.96875rem;
    color: var(--accent);
    padding: 9px 14px;
    border: 1px solid var(--accent);
    border-radius: 3px;
    transition:
      background 160ms ease,
      color 160ms ease;
  }
  .cta-link:hover {
    background: var(--accent);
    color: var(--bg-base);
  }

  /* ─── Footer ───────────────────────────────────────────── */
  .footer {
    padding: 22px 0 36px;
    border-top: 1px solid var(--rule);
    display: flex;
    /* The links and the build meta together just exceed the frame, so the meta
       wraps to a second row. Both rows are centred; the column gap keeps the
       two apart on the rare width where they do fit on one line. */
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 32px;
    font-family: var(--mono);
    font-size: 0.90625rem;
    color: var(--fg);
  }
  .footer-links {
    display: flex;
    gap: 22px;
  }
  .footer-links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }
  .footer-meta {
    /* Own row always: the links and the meta now both fit on one line, and a
       wrap-dependent break would come and go with the viewport. */
    flex-basis: 100%;
    text-align: center;
    color: var(--muted);
    font-size: 0.75rem;
  }

  /* ─── Responsive: mobile ≤640px ────────────────────────── */
  /* The 3-track grid needs 740 + 28px of track, but .frame only offers
     viewport - 64px. Below ~832px it no longer fits, so the pitch section
     stacks early. Type and padding stay desktop until 640px. */
  @media (max-width: 831px) {
    .section {
      grid-template-columns: 1fr;
    }
    .pitch-section .side-col {
      grid-column: 1;
      padding-top: 16px;
    }
    .pull-quote {
      max-width: none;
      margin-left: 0;
    }
  }

  @media (max-width: 640px) {
    .frame {
      padding: 0 22px;
    }

    .hero {
      padding: 36px 0 18px;
    }
    .hero-art {
      padding-bottom: 20px;
    }
    .hero h1 {
      font-size: 2.46875rem;
      margin-bottom: 10px;
    }
    .tagline {
      font-size: 0.78125rem;
      margin-bottom: 10px;
    }
    .subline {
      font-size: 1.09375rem;
    }

    .section {
      grid-template-columns: 1fr;
      padding: 24px 0;
    }
    .pitch-section .side-col {
      /* Reset desktop's grid-column: 3 so the pull-quote stacks under the
         pitch in the single-column mobile layout. */
      grid-column: 1;
      padding-top: 16px;
      border-top: 1px dashed var(--rule-2);
      margin-top: 16px;
    }
    .pitch {
      font-size: 1.15625rem;
    }
    .pull-quote {
      font-size: 0.96875rem;
      /* Desktop pushes pull-quote right with margin-left: auto so it lines up
         with tile sidenotes. On mobile (single-column stack) we want it
         left-aligned in the full-width column. */
      max-width: none;
      margin-left: 0;
    }

    .tiles-header {
      padding: 24px 0 16px;
    }

    .tile-row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 18px 0;
      margin: 0;
    }
    /* On mobile the row has no negative margin, so the pseudo-element rule
       lines should sit at the row's full width (left:0 right:0) — not inset
       12px the way they do on desktop. */
    .tile-row::after,
    .tile-row:first-child::before {
      left: 0;
      right: 0;
    }
    .tile-num {
      font-size: 0.75rem;
    }
    .tile-heading {
      font-size: 1.5rem;
    }
    .tile-body {
      font-size: 0.96875rem;
    }
    .tile-side {
      padding: 8px 0 0;
      border-top: 1px dashed var(--rule-2);
      margin-top: 12px;
      align-items: flex-start;
      text-align: left;
    }
    .sidenote-live {
      justify-content: flex-start;
    }

    .availability {
      grid-template-columns: 1fr;
      padding: 24px 0;
    }
    .avail-right {
      /* Reset desktop's grid-column: 2 so the block stacks under the
         eyebrow + pill in the single-column mobile layout. */
      grid-column: 1;
    }
    .shapes li {
      font-size: 0.96875rem;
    }
    .cta {
      flex-direction: column;
      gap: 12px;
    }

    .footer {
      flex-direction: column;
      align-items: center;
      gap: 8px;
