---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';

// ─── Live (build-time) values ────────────────────────────────────
// Regenerated on every Coolify rebuild. If these go stale, redeploy.
const buildDate = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
// Last commit on Pipeforge — placeholder for now; later wire to a fetch.
// To make truly live: replace with build-time fetch from GitHub API.
const pipeforgeLastCommit = 'today';

// ─── Tile data ───────────────────────────────────────────────────
const tiles = [
  {
    n: '01',
    title: 'Pipeforge',
    tagline: 'personal AI delivery infrastructure',
    body: '31 commands, 28 SKILL.md files, 20 agents, 64 MCP tools — screenshot walkthrough of real runs.',
    href: '/pipeforge',
    live: null,
    durable: 'private tool · used daily',
  },
  {
    n: '02',
    title: 'Knowledge base',
    tagline: 'how decisions get captured',
    body: '5 selected entries from ~42 Knowledge-Base entries about Pipeforge itself — rationale, rejected alternatives, source citations.',
    href: '/kb',
    live: null,
    durable: 'authored during real work',
  },
  {
    n: '03',
    title: 'Production work',
    tagline: 'what the workflow ships',
    body: 'Education CRM in production (4,190 tests as of 2026-04-27); ProfitOfExile, ~72k LOC across Go / SvelteKit / Tauri in ~2 weeks.',
    href: '/about',
    live: null,
    durable: 'in production since 2025-Q3',
  },
];
---

<Base
  title="Sebastian Rogala — AI-native product engineer"
  description="Independent AI-native product engineer. Designer of Pipeforge — Claude Code orchestration with MCP-backed context engineering. Currently shipping a production multi-tenant CRM and a public-source community tool."
>
  <TopNav current="home" />

  <main class="frame">
    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="hero">
      <h1>Sebastian Rogala</h1>
      <p class="tagline">AI-native product engineer · Context Engineer</p>
    </section>

    <!-- ── Manifest (2 lines: currently + bases). today: dropped to reduce metric density. -->
    <section class="manifest">
      <div class="manifest-row">
        <span class="manifest-label">currently:</span>
        <span class="manifest-value sans">
          developing <span class="accent">Pipeforge</span> orchestrator · multi-tenant <span class="accent">CRM</span> in production · <span class="accent">Desktop app</span> for POE community
        </span>
      </div>
      <div class="manifest-row">
        <span class="manifest-label">bases:</span>
        <span class="manifest-value mono">
          Rzeszów · UTC+2 · running Claude Opus 4.7 on Pipeforge · discovering Codex
        </span>
      </div>
    </section>

    <!-- ── Pitch + pull-quote ────────────────────────────────── -->
    <section class="section pitch-section">
      <div class="main-col">
        <div class="eyebrow">What I do</div>
        <p class="pitch">
          I design AI-directed delivery systems that turn product intent into shipped, verified software. Twelve
          years of software background; fully AI-directed since early 2026. Currently shipping a production
          multi-tenant CRM, a public-source community tool, and Pipeforge — my Claude Code orchestration and
          MCP-backed workflow infrastructure.
        </p>
      </div>
      <div class="side-col">
        <div class="pull-quote">
          “AI failures are spec gaps, not agent shortcomings.”
          <div class="pull-quote-attr">— core principle, in practice</div>
        </div>
      </div>
    </section>

    <!-- ── Tiles header ─────────────────────────────────────── -->
    <section class="section tiles-header">
      <div class="eyebrow">Things I'm working on / pointing to</div>
      <div class="tiles-count">3 entries</div>
    </section>

    <!-- ── Work tiles ────────────────────────────────────────── -->
    <section class="tiles">
      {
        tiles.map((t) => (
          <a href={t.href} class="tile-row tile-link">
            <div class="tile-num">{t.n}</div>
            <div class="tile-content">
              <div class="tile-heading">
                {t.title}
                <span class="tile-tagline"> — {t.tagline}</span>
              </div>
              <div class="tile-body">{t.body}</div>
            </div>
            <div class="tile-arrow">{t.href} →</div>
            <div class="tile-side">
              {t.live && (
                <div class="sidenote-live">
                  <span class="live-dot" />
                  {t.live}
                </div>
              )}
              <div class="sidenote-durable">{t.durable}</div>
            </div>
          </a>
        ))
      }
    </section>

    <!-- ── Availability (no fixed quarter — just an "open" signal). ─ -->
    <section class="section availability">
      <div class="avail-left">
        <div class="eyebrow">Availability</div>
        <div class="status-pill">
          <span class="status-dot"></span>
          open
        </div>
      </div>
      <p class="avail-text">
        Currently open to AI-native Product Engineer / Context Engineer roles at AI-forward teams, and to
        consulting or workshop conversations on context engineering and AI-directed delivery. Most teams I talk
        to discover that the workflow itself is the unfamiliar part — happy to walk through it.
      </p>
    </section>

    <!-- ── Footer ─────────────────────────────────────────── -->
    <footer class="footer">
      <div class="footer-links">
        <a href="mailto:sebrogala@gmail.com">sebrogala@gmail.com</a>
        <span class="sep">·</span>
        <a href="https://linkedin.com/in/seb-rogala" target="_blank" rel="noopener">linkedin.com/in/seb-rogala</a>
        <span class="sep">·</span>
        <a href="https://github.com/SebRogala" target="_blank" rel="noopener">github.com/SebRogala</a>
      </div>
      <div class="footer-meta">designed with Claude Design · latest build {buildDate}</div>
    </footer>
  </main>
</Base>

<style>
  /* ─── Layout constants ────────────────────────────────────── */
  /* Frame 1140 max · Body 660 + 28 gutter + 1fr right column.
     Pull-quote constrained by .pull-quote max-width; tile sidenotes right-align. */

  .frame {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Topnav + mobile-subnav styles live in src/components/TopNav.astro. */

  /* `.sep` is also used inside the page footer below — keep as page-level rule. */
  .sep {
    color: var(--rule-2);
  }

  /* ─── Hero ─────────────────────────────────────────────── */
  .hero {
    padding: 60px 0 24px;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 56px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-bottom: 14px;
  }
  .tagline {
    font-size: 16px;
    color: var(--muted);
    letter-spacing: -0.005em;
  }

  /* ─── Manifest ─────────────────────────────────────────── */
  .manifest {
    padding: 24px 0 44px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.85;
  }
  .manifest-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .manifest-row + .manifest-row {
    margin-top: 8px;
  }
  .manifest-label {
    color: var(--accent);
    width: 80px;
    flex-shrink: 0;
  }
  .manifest-value.sans {
    font-family: var(--sans);
    font-size: 17px;
    color: var(--fg);
    line-height: 1.6;
    letter-spacing: -0.005em;
  }
  .manifest-value.mono {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg-nav);
    line-height: 1.65;
  }
  .manifest .accent {
    color: var(--accent);
  }

  /* ─── Pitch section ────────────────────────────────────── */
  .section {
    padding: 40px 0 52px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 740px 28px 1fr;
  }
  .pitch-section .main-col {
    grid-column: 1;
  }
  .pitch-section .side-col {
    grid-column: 3;
    padding-top: 30px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .pitch {
    font-family: var(--serif);
    /* Pitch weight bumped from 400 → 500 to anchor the page (one of three metric-reduction tweaks) */
    font-weight: 500;
    font-size: 22px;
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
  }

  .pull-quote {
    /* width capped + pushed to the right of column 3 so the pull-quote sits
       at the same right-edge as the tile sidenotes below — visual consistency
       across the page. */
    max-width: 240px;
    margin-left: auto;
    border-left: 2px solid var(--accent);
    padding-left: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--fg);
    text-wrap: pretty;
  }
  .pull-quote-attr {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-style: normal;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* ─── Tiles header ─────────────────────────────────────── */
  .tiles-header {
    border-top: 1px solid var(--rule);
    padding: 32px 0 20px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    grid-template-columns: none;
  }
  .tiles-header .eyebrow {
    margin-bottom: 0;
  }
  .tiles-count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-nav);
  }

  /* ─── Tiles ────────────────────────────────────────────── */
  /* Each tile-row IS the link. Sidenote sits in column 4 of the same grid,
     so the whole row is one click target with one continuous hover state. */
  .tiles {
    padding: 0 0 48px;
  }
  .tile-row {
    position: relative;
    display: grid;
    grid-template-columns: 36px 1fr 110px 240px;
    gap: 22px;
    padding: 22px 12px;
    margin: 0 -12px;
    align-items: baseline;
    border-radius: 4px;
    color: inherit;
    transition: background 160ms ease;
  }
  /* Rule lines as pseudo-elements, inset 12px so they align with the frame
     content edge (matching the section borders above/below) — not with the
     row's outset hover background. */
  .tile-row::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 1px;
    background: var(--rule);
  }
  /* The next section (.availability) brings its own border-top, so suppressing
     the last row's bottom rule prevents two near-adjacent lines with whitespace
     between them. */
  .tile-row:last-child::after {
    display: none;
  }
  .tile-row:first-child::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 1px;
    background: var(--rule);
  }
  .tile-row:hover {
    background: var(--bg-raise);
  }
  .tile-row:hover .tile-heading {
    color: var(--accent);
  }
  .tile-row:hover .tile-arrow {
    transform: translateX(2px);
  }
  .tile-num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg-nav);
  }
  .tile-heading {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.018em;
    color: var(--fg);
    margin-bottom: 4px;
    transition: color 160ms ease;
  }
  .tile-tagline {
    color: var(--muted);
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
  }
  .tile-body {
    font-family: var(--sans);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--fg);
    opacity: 0.78;
    text-wrap: pretty;
  }
  .tile-arrow {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--accent);
    text-align: right;
    font-weight: 500;
    transition: transform 160ms ease;
    display: inline-block;
  }

  .tile-side {
    /* sits in column 4 of the .tile-row grid (the row IS the link) */
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--fg-nav);
    text-align: right;
  }
  .sidenote-live {
    color: var(--fg);
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .sidenote-durable {
    color: var(--fg-nav);
  }
  .live-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--live-dot);
    margin-right: 7px;
    box-shadow: 0 0 4px rgba(200, 174, 106, 0.4);
  }

  /* ─── Availability ─────────────────────────────────────── */
  .availability {
    padding: 36px 0 44px;
    grid-template-columns: 180px 1fr;
    gap: 24px;
  }
  .avail-left {
    grid-column: 1;
  }
  .availability .eyebrow {
    margin-bottom: 12px;
  }
  .status-pill {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--status-fg);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px;
    background: var(--status-bg);
    border: 1px solid var(--rule-2);
  }
  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--status-fg);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(166, 212, 159, 0.53);
  }
  .avail-text {
    grid-column: 2;
    font-family: var(--serif);
    /* Bumped to weight 500 to match pitch (consistent identity hierarchy) */
    font-weight: 500;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--fg);
    text-wrap: pretty;
  }

  /* ─── Footer ───────────────────────────────────────────── */
  .footer {
    padding: 22px 0 36px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--fg);
  }
  .footer-links {
    display: flex;
    gap: 22px;
  }
  .footer-links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(125, 179, 108, 0.33);
  }
  .footer-meta {
    color: var(--fg-nav);
    font-size: 12.5px;
  }

  /* ─── Responsive: mobile ≤640px ────────────────────────── */
  @media (max-width: 640px) {
    .frame {
      padding: 0 22px;
    }

    .hero {
      padding: 36px 0 18px;
    }
    .hero h1 {
      font-size: 36px;
      margin-bottom: 10px;
    }
    .tagline {
      font-size: 13.5px;
    }

    .manifest {
      padding: 20px 0 24px;
    }
    .manifest-row {
      flex-direction: column;
      gap: 4px;
    }
    .manifest-label {
      width: auto;
      font-size: 11.5px;
    }
    .manifest-value.sans {
      font-size: 14.5px;
    }
    .manifest-value.mono {
      font-size: 12px;
    }

    .section {
      grid-template-columns: 1fr;
      padding: 24px 0;
    }
    .pitch-section .side-col {
      padding-top: 16px;
      border-top: 1px dashed var(--rule-2);
      margin-top: 16px;
    }
    .pitch {
      font-size: 17px;
    }
    .pull-quote {
      font-size: 14px;
    }

    .tiles-header {
      padding: 24px 0 16px;
    }

    .tile-row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 18px 0;
      margin: 0;
    }
    .tile-num {
      font-size: 11px;
    }
    .tile-heading {
      font-size: 22px;
    }
    .tile-body {
      font-size: 14px;
    }
    .tile-arrow {
      text-align: left;
      margin-top: 8px;
    }
    .tile-side {
      padding: 8px 0 0;
      border-top: 1px dashed var(--rule-2);
      margin-top: 12px;
      text-align: left;
    }
    .sidenote-live {
      justify-content: flex-start;
    }

    .availability {
      grid-template-columns: 1fr;
      padding: 24px 0;
    }
    .avail-text {
      font-size: 16px;
    }

    .footer {
      flex-direction: column;
      gap: 8px;
      padding: 20px 0 28px;
    }
    .footer-links {
      flex-direction: column;
      gap: 4px;
    }
    .footer-links .sep {
      display: none;
    }
  }
</style>
